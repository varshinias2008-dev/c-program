
#include <stdio.h>

unsigned long original_checks, redesigned_checks;

int prime_original(unsigned long n) {
    original_checks = 0;

    if (n < 2)
        return 0;

    for (unsigned long d = 2; d <= n / d; d++) {
        original_checks++;

        if (n % d == 0)
            return 0;
    }

    return 1;
}

int prime_skip_even(unsigned long n) {
    redesigned_checks = 0;

    if (n < 2)
        return 0;

    if (n == 2)
        return 1;

    if (n % 2 == 0) {
        redesigned_checks++;
        return 0;
    }

    for (unsigned long d = 3; d <= n / d; d += 2) {
        redesigned_checks++;

        if (n % d == 0)
            return 0;
    }

    return 1;
}

int main(void) {
    unsigned long values[] = {97, 100, 7919, 1000003};

    for (int i = 0; i < 4; i++) {
        int p1 = prime_original(values[i]);
        int p2 = prime_skip_even(values[i]);

        printf("%lu: %s | original=%lu checks | redesigned=%lu checks\n",
               values[i],
               (p1 && p2) ? "prime" : "not prime",
               original_checks,
               redesigned_checks);
    }

    return 0;
}

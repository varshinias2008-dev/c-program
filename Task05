
#include <stdio.h>

unsigned long checks = 0;

int is_prime_for(unsigned long n) {
    checks = 0;

    if (n < 2)
        return 0;

    for (unsigned long i = 2; i <= n / i; i++) {
        checks++;

        if (n % i == 0)
            return 0;
    }

    return 1;
}

int is_prime_while(unsigned long n) {
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    while (i <= n / i) {
        checks++;

        if (n % i == 0)
            return 0;

        i++;
    }

    return 1;
}

int is_prime_do(unsigned long n) {
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    if (i > n / i)
        return 1;

    do {
        checks++;

        if (n % i == 0)
            return 0;

        i++;
    } while (i <= n / i);

    return 1;
}

int main(void) {
    unsigned long tickets[] = {97, 100, 7919, 1000003};

    for (int k = 0; k < 4; k++) {
        int p = is_prime_for(tickets[k]);

        printf("%8lu %-9s divisions = %lu\n",
               tickets[k],
               p ? "prime" : "not prime",
               checks);
    }

    puts("Loop versions (while and do-while) use the same safe divisor bound.");

    for (int k = 0; k < 4; k++) {
        int p = is_prime_while(tickets[k]);

        printf("while: %lu %s checks=%lu\n",
               tickets[k], p ? "prime" : "not prime", checks);

        p = is_prime_do(tickets[k]);

        printf("do:    %lu %s checks=%lu\n",
               tickets[k], p ? "prime" : "not prime", checks);
    }

    return 0;
}
